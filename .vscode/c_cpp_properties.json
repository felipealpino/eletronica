{
  "configurations": [
    {
      "name": "Arduino Uno",
      "compilerPath": "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
      "compilerArgs": ["-mmcu=atmega328p"],
      "intelliSenseMode": "gcc-x64",
      "cStandard": "gnu11",
      "cppStandard": "gnu++11",
      "includePath": [
        "${workspaceFolder}/**",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.8/variants/standard",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.8/libraries/**",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/avr/include",
        "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/lib/gcc/avr/7.3.0/include",
        "${env:HOME}/Documents/Arduino/libraries/**"
      ],
      "forcedInclude": [
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.8/cores/arduino/Arduino.h"
      ],
      "defines": [
        "F_CPU=16000000L",
        "ARDUINO=10607",
        "ARDUINO_AVR_UNO",
        "ARDUINO_ARCH_AVR",
        "__AVR_ATmega328P__",
        "__AVR__"
      ]
    }
  ],
  "version": 4
}
